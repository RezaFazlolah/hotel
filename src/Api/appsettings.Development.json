{
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=hotel;Username=postgres;Password=1234",
    "SqlServer": "Server=localhost,1434;Database=HotelDb;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True;",
    "SQLite": "Data Source=HotelDb.db"
  },
  "JwtSettings": {
    "Key": "THIS_IS_A_DEVELOPMENT_KEY_CHANGE_IT_32+",
    "Issuer": "http://localhost:5008",
    "Audience": "http://localhost:5008",
    "DurationInMinutes": 150000
  },
  "PaginationSettings": {
    "MaxPageSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Overrider": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
